# ============================================================
# Exami — วางไฟล์นี้ใน Coolify ได้เลย (+ New → Dockerfile, ไม่ต้องเชื่อม Git)
# ระบบจะดึงโค้ดล่าสุดจาก GitHub ให้อัตโนมัติทุกครั้งที่กด Deploy
# ถ้า fork ไปไว้ GitHub ของตัวเอง ให้แก้บรรทัด REPO ด้านล่างบรรทัดเดียว
# ============================================================
ARG REPO=https://github.com/YOUR-GITHUB/exami
ARG BRANCH=main

FROM ollama/ollama:latest AS ollama
RUN rm -rf /usr/lib/ollama/cuda* /usr/lib/ollama/rocm* /usr/lib/ollama/vulkan* /usr/lib/ollama/jetpack* || true

FROM node:22-bookworm-slim
ARG REPO
ARG BRANCH
ENV NODE_ENV=production TZ=Asia/Bangkok PORT=3000 DATA_DIR=/data \
    OLLAMA_HOST=127.0.0.1:11434 OLLAMA_MODELS=/data/ollama OLLAMA_KEEP_ALIVE=30m OLLAMA_NUM_PARALLEL=1
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ollama /usr/bin/ollama /usr/bin/ollama
COPY --from=ollama /usr/lib/ollama /usr/lib/ollama
ADD ${REPO}/archive/refs/heads/${BRANCH}.tar.gz /tmp/exami.tar.gz
RUN mkdir -p /app && tar -xzf /tmp/exami.tar.gz -C /app --strip-components=1 && rm /tmp/exami.tar.gz
WORKDIR /app
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force && chmod +x docker-entrypoint.sh && mkdir -p /data
VOLUME ["/data"]
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s CMD node -e "fetch('http://127.0.0.1:3000/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["./docker-entrypoint.sh"]
